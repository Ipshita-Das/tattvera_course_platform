# DATABASE
# Neon Postgres Connection String
DATABASE_URL="postgresql://[user]:[password]@[host]/[dbname]?sslmode=require"

# AUTHENTICATION (Auth.js / NextAuth)
# Generate a secret using: npx auth secret
AUTH_SECRET="your-generated-auth-secret-here"

# GITHUB OAUTH
# Create an OAuth app at: https://github.com/settings/applications/new
AUTH_GITHUB_ID="your-github-client-id"
AUTH_GITHUB_SECRET="your-github-client-secret"

# STRIPE INTEGRATION
# Secret key from Stripe Dashboard (Developers -> API keys)
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
# Webhook signing secret from Stripe Dashboard (Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# APPLICATION URL
# The base URL of your application (used for Stripe redirects)
# Use http://localhost:3000 for local development
APP_URL="http://localhost:3000"